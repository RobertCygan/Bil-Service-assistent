<?xml version="1.0" encoding="utf-8"?>
<!-- The owner's logo on the app's dark background. The launcher cuts this to its own shape (circle, squircle, ...). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/cockpit_background" />
    <foreground android:drawable="@drawable/logo_foreground" />
    <!-- For phones that tint icons in one colour: the same shape, taken from where the logo is opaque. -->
    <monochrome android:drawable="@drawable/logo_foreground" />
</adaptive-icon>
